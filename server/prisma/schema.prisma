generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

model User {
    id              String     @id @default(auto()) @map("_id") @db.ObjectId
    name            String?
    email           String     @unique
    image           String?
    bookedVisits    Json[]
    favBusinessesID String[]   @db.ObjectId
    ownedBusiness   Business[] @relation("Owner")
}

model Business {
    id             String   @id @default(auto()) @map("_id") @db.ObjectId
    title          String
    sdescription   String
    ldescription   String
    category       String
    address        String
    city           String
    country        String
    additionalinfo String
    images         String[]
    socials        Json
    userEmail      String
    owner          User     @relation("Owner", fields: [userEmail], references: [email])
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    @@unique(fields: [address, userEmail])
}
